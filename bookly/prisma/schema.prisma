generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// catalog-svc models (catalog_db)
// ============================================
model Book {
  id              Int      @id @default(autoincrement())
  title           String
  author          String
  genre           String
  isbn            String   @unique
  description     String
  coverUrl        String?
  pdfUrl          String?
  price           Decimal  @db.Decimal(10, 2)
  availableCopies Int      @default(0)
  totalCopies     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("books")
}

// ============================================
// users-svc models (users_db)
// ============================================
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// ============================================
// transaction-svc models (transaction_db)
// ============================================
model Rental {
  id        Int      @id @default(autoincrement())
  userId    Int
  bookId    Int
  startedAt DateTime @default(now())
  expiresAt DateTime
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("rentals")
}

model Purchase {
  id        Int      @id @default(autoincrement())
  userId    Int
  bookId    Int
  price     Decimal  @db.Decimal(10, 2)
  status    String   @default("COMPLETED")
  createdAt DateTime @default(now())

  @@map("purchases")
}

model NotificationOutbox {
  id         Int      @id @default(autoincrement())
  userId     Int
  rentalId   Int?
  purchaseId Int?
  eventType  String
  payload    Json
  status     String   @default("PENDING")
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("notification_outbox")
}

// ============================================
// notif-svc models (notif_db)
// ============================================
model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  type      String
  subject   String
  message   String
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("notifications")
}
