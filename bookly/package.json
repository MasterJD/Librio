{
  "name": "bookly",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "pnpm -r build",
    "build:web": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "serve:ssr:bookly": "node dist/bookly/server/server.mjs",
    "dev:catalog": "pnpm --filter catalog-svc dev",
    "dev:users": "pnpm --filter users-svc dev",
    "dev:transaction": "pnpm --filter transaction-svc dev",
    "dev:notif": "pnpm --filter notif-svc dev",
    "dev:mcp": "pnpm --filter library-mcp dev"
  },
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.21",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.21",
    "@angular/cli": "^21.2.21",
    "@angular/compiler-cli": "^21.2.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
